{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Check Toolchain",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/project.ps1", "-Action", "Check"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "Setup VSCode DAPLink",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/project.ps1", "-Action", "Setup"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "Configure Debug",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/project.ps1", "-Action", "Configure", "-Configuration", "Debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "Build Debug",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/project.ps1", "-Action", "Build", "-Configuration", "Debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": "$gcc"
        },
        {
            "label": "Build Release",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/project.ps1", "-Action", "Build", "-Configuration", "Release"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": "$gcc"
        },
        {
            "label": "Flash DAPLink OpenOCD",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/project.ps1", "-Action", "Flash", "-Configuration", "Debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": "$gcc"
        },
        {
            "label": "Reset Run DAPLink OpenOCD",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/project.ps1", "-Action", "Reset"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "Test Runtime Control",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tests/rdk_uart/run_runtime_control_tests.ps1"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": "$gcc"
        },
        {
            "label": "Export Source Package",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/export_source.ps1"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        }
    ]
}
